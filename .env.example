# Odoo web endpoint
BASE_URL=http://localhost:8069

# TEST-ONLY administration credentials for the LOCAL database initialised by
# docker-compose. These credentials are created by Odoo's default bootstrap
# (super admin "admin"/"admin") and are NOT real production secrets.
ODOO_USER=admin
ODOO_PASSWORD=admin

# Optional: path to a custom Chrome binary on non-standard machines.
# CHROME_BINARY=/usr/bin/google-chrome